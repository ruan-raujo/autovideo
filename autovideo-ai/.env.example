# Dados/modelos fora do OneDrive. Padrão: %LOCALAPPDATA%/AutoVideoAI
# AUTOVIDEO_DATA_DIR=C:/Users/SEU_USUARIO/AppData/Local/AutoVideoAI
AUTOVIDEO_WORKER_ENABLED=true
# Descobertos automaticamente após instalar_midia.bat:
# AUTOVIDEO_FFMPEG_PATH=C:/ferramentas/ffmpeg/bin/ffmpeg.exe
# AUTOVIDEO_FFPROBE_PATH=C:/ferramentas/ffmpeg/bin/ffprobe.exe
# AUTOVIDEO_VOICE_PATH=C:/vozes/pt_BR-faber-medium-aligned.onnx
# AUTOVIDEO_VOICE_EN_PATH=C:/vozes/en_US-ljspeech-high-aligned.onnx
# Endpoint somente local; modelos de nuvem são recusados.
AUTOVIDEO_OLLAMA_URL=http://127.0.0.1:11434
AUTOVIDEO_OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
